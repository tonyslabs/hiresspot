{
  "name": "hiresspot-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "HiResSpot: reproductor hi-fi, cliente Navidrome y comparador de bibliotecas",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @hiresspot/desktop",
    "package": "npm run package -w @hiresspot/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
